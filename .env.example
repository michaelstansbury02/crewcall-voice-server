# ---- Server ----
PORT=3000
# Public base URL of THIS server (https, no trailing slash). Used for Twilio
# signature validation and must match the voice webhook URL you set in Twilio.
# Example: PUBLIC_BASE_URL=https://crewcall-voice.fly.dev
PUBLIC_BASE_URL=
# Host (no protocol, no path) placed inside the TwiML <Stream> URL.
# Example: PUBLIC_WS_HOST=crewcall-voice.fly.dev
PUBLIC_WS_HOST=

# ---- Twilio (required for live calls + SMS) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional: default SMS sender if a business has no Twilio number of its own.
TWILIO_SMS_FROM=
# Optional fallback business id when the To number isn't in config/businesses.json
DEFAULT_BUSINESS_ID=
# NEVER enable in production. Skips X-Twilio-Signature validation (local dev only).
SKIP_SIGNATURE_CHECK=false

# ---- Speech-to-text (Deepgram streaming) ----
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# ---- Conversation LLM ----
# anthropic | openai | auto (auto = anthropic if ANTHROPIC_API_KEY set, else openai)
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Text-to-speech (OpenAI) ----
TTS_VOICE=nova

# ---- Post-call logging (optional; falls back to ./data/calls.jsonl) ----
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
